# Copy this file to .env and change every value that is specific to your NAS.

# Use :slim for the smaller core image. For a local source build, use
# IMAGE_NAME=ugreen-nas-codespace:local with compose/build.yml.
IMAGE_NAME=joweenflores/ugreen-nas-codespace:latest
CONTAINER_NAME=ugreen-codespace
CONTAINER_HOSTNAME=codespace

# Required. Run ./scripts/generate-hashed-password.sh and paste its complete
# Compose-safe output here. Plaintext PASSWORD is rejected.
HASHED_PASSWORD=

# Bind to 127.0.0.1 when a tunnel/VPN process on the NAS is the only ingress.
BIND_ADDRESS=0.0.0.0
WEB_PORT=8443
TZ=Asia/Manila

# Key-only SSH for local terminals and VS Code Remote-SSH. Paste one public key;
# never paste a private key. Set ENABLE_SSH=false to disable the SSH service.
ENABLE_SSH=true
SSH_BIND_ADDRESS=0.0.0.0
SSH_PORT=2222
SSH_AUTHORIZED_KEY=

# Match the owner of WORKSPACE_PATH on the NAS.
PUID=1000
PGID=1000
DOCKER_USER=coder
WORKSPACE_PATH=/volume1/docker/ugreen-nas-codespace/workspace

# Only required with compose/docker-socket.yml.
DOCKER_GID=999

# Build-time versions. Pin the npm values to exact releases for reproducible
# release builds; "latest" intentionally follows the upstream release channel.
IMAGE_VARIANT=full
CODE_SERVER_VERSION=4.130.0
UV_VERSION=0.11.32
NVM_VERSION=v0.40.6
NODE_VERSION=24
CLAUDE_CODE_VERSION=latest
CODEX_VERSION=latest
OPENCODE_VERSION=latest
